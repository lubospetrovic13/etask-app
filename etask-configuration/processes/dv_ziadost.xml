		<sourceId>p_na_schvalenie</sourceId>
		<destinationId>t_dv_rozhodnutie</destinationId>
		<multiplicity>1</multiplicity>
	</arc>
	<!--
		Dva variable arcy z toho istého prechodu. Variable arc sa nepíše ako
		type="variable" - je to regular s multiplicity 0 a <reference> na number
		pole, ktoré akcia v phase="pre" nastaví na 0 alebo 1. Token teda vystrelí
		presne jeden z nich, podľa voľby vedúceho.

		Preto je vrátenie tretia možnosť v jednom tasku a nie samostatný prechod:
		rozhodnutie je jedno rozhodnutie, len má tri vyústenia.
	-->
	<arc>
		<id>a_rozhodnutie_vybavit</id>
		<type>regular</type>
		<sourceId>t_dv_rozhodnutie</sourceId>
		<destinationId>p_vybavena</destinationId>
		<multiplicity>0</multiplicity>
		<reference>dv_to_vybavena</reference>
	</arc>
	<arc>
		<id>a_rozhodnutie_vratit</id>
		<type>regular</type>
		<sourceId>t_dv_rozhodnutie</sourceId>
		<destinationId>p_koncept</destinationId>
		<multiplicity>0</multiplicity>
		<reference>dv_to_koncept</reference>
	</arc>
	<arc>
		<id>a_vysledok</id>
		<type>read</type>
		<sourceId>p_vybavena</sourceId>
		<destinationId>t_dv_vysledok</destinationId>
		<multiplicity>1</multiplicity>
	</arc>
</document>
