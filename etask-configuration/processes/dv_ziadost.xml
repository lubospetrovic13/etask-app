	<!--
		Schvaľovanie dovoleniek pre jedno oddelenie.

		Tri stavy, jeden prechod na podanie a jeden na rozhodnutie:

		  p_koncept -> t_dv_podanie -> p_na_schvalenie -> t_dv_rozhodnutie -+-> p_vybavena
		      ^                                                            |
		      +....... variable arc, ked veduci vrati na prerobenie ........+

		Rozhodnutie je JEDEN task s tromi moznostami - Schvalit, Zamietnut,
		Vratit na prerobenie. Nie tri tasky: vedúci sa raz rozhoduje, len to má
		tri vyústenia. Smerovanie tokenu robia dva variable arcy z toho istého
		prechodu, ktorých násobnosť nastaví akcia v `phase="pre"` (`dv_to_vybavena`,
		`dv_to_koncept`). Prvá verzia mala na vrátenie samostatný prechod, takže
		vedúci videl v case dve úlohy a musel si vybrať, ktorú otvorí, skôr než
		sa rozhodol.

		Pri vrátení sa token vráti do p_koncept, žiadateľovi sa znova otvorí
		"Podať žiadosť" s pôvodnými hodnotami a vedúcemu žiadosť zmizne z "Na
		schválenie". Cyklus môže prebehnúť koľkokrát treba; to, čo sa pri
		prepisovaní poznámky stráca, drží `dv_historia`.

		Kto čo vidí, drží model, nie frontend:

		  * `dv_ziadatel` je userList, do ktorého sa pri založení casu zapíše
		    prihlásený človek. Na ňom visí `userRef` s `caseLogic/view` (žiadateľ
		    vidí svoju žiadosť) aj `perform` na podaní a prehľade. Rola
		    `zamestnanec` má na úrovni procesu iba `create` - takže zamestnanec
		    vie žiadosť založiť, ale cudziu neuvidí. Bez toho userRefu by buď
		    videl všetky žiadosti oddelenia, alebo ani vlastnú.
		  * `veduci` má `view` na procese a `perform` na rozhodnutí. Rozhodnutie
		    je vlastný prechod za vlastným miestom, takže sa nedá spraviť skôr,
		    než je žiadosť podaná - a po rozhodnutí už token v p_na_schvalenie
		    nie je, takže sa nedá prepísať druhýkrát.
		  * Read-only pohľad je jeden a visí na read arcu z `p_vybavena`:
		    `t_dv_vysledok`. Predtým tu bol prehľad na vlastnom mieste `p_alive`,
		    otvorený od založenia casu - dôsledok bol, že každý mal v case
		    o úlohu viac, než mal reálne robiť. Koľko úloh kto vidí teraz:

		      rozpísaná / vrátená   žiadateľ 1 (Podať žiadosť), vedúci 0
		      čaká na schválenie    žiadateľ 0,                 vedúci 1 (Rozhodnúť)
		      vybavená              obaja 1 (Výsledok)

		    Kým sa čaká, žiadateľ nemá čo robiť a stav si prečíta z názvu casu
		    v zozname - preto názov vždy končí stavom.

		    POZOR, tu bola medzikrokom chyba, ktorá stojí za zapamätanie:
		    read-only pohľad `t_dv_podana` visel na read arcu z `p_na_schvalenie`,
		    teda z miesta, ktoré `t_dv_rozhodnutie` KONZUMUJE. Keď vedúci klikol
		    DOKONČIŤ a dokončenie bolo odmietnuté (prázdna voľba alebo výnimka
		    z `phase="pre"`), engine tú read-only úlohu zmazal a už ju nikdy
		    neobnovil - token sa nepohol, takže nebolo čo ju znova povoliť.
		    Žiadateľ tým natrvalo stratil pohľad na vlastnú žiadosť a nikde sa
		    to neohlásilo. Read arc pre pohľad patrí len na miesto, ktoré žiadny
		    prechod nekonzumuje (v sd_ticket je to `p_alive`), alebo na koncové
		    miesto ako `p_vybavena`. Podrobne v docs/PETRIFLOW_LEARNINGS.md.

		Kontrola dátumov je dvakrát a zámerne: `set` event prepočítava počet dní
		a píše varovanie hneď pri písaní, `phase="pre"` na dokončení podania to
		isté vyhodí ako výnimku. Prvé je pohodlie, druhé je jediné, čo naozaj
		zabráni podať žiadosť s dátumom do pred dátumom od - `required` overí len
		to, že pole nie je prázdne.
	-->
	<caseEvents>
		<event type="create">
			<id>dv_create</id>
			<actions phase="post">
				<action id="1"><![CDATA[
dv_ziadatel: f.dv_ziadatel, dv_ziadatel_meno: f.dv_ziadatel_meno,
dv_stav: f.dv_stav, dv_stav_label: f.dv_stav_label,
dv_od: f.dv_od, dv_do: f.dv_do;

def u = loggedUser()
def meno = kto(u)

change dv_ziadatel value { [u.id] }
change dv_ziadatel_meno value { meno }
change dv_stav value { "koncept" }
change dv_stav_label value { "Rozpísaná" }
changeCaseProperty("color").about { farba("koncept") }
// Zamestnanec nazov nezadava - polozka menu ma vypnute `enable_case_title`,
// takze "+" zaklada case rovno a nazov vznikne tu.
changeCaseProperty("title").about { nazov(dv_od, dv_do, dv_ziadatel_meno, "Rozpísaná") }
				]]></action>
			</actions>
		</event>
	</caseEvents>
	<function scope="process" name="kto"><![CDATA[
{ def u ->
    // Nie `u?.fullName` - `?.` chráni pred null, nie pred chýbajúcou property,
    // a na chýbajúcej vyhodí MissingPropertyException uprostred akcie.
    // `loggedUser()` sa posiela ako argument: bezparametrická process funkcia
    // nie je v tomto repozitári nikde overená.
    return (u.hasProperty("fullName") && u.fullName) ? (u.fullName as String) : (u.email as String)
}
	]]></function>
	<function scope="process" name="nazov"><![CDATA[
{ def dv_od, def dv_do, def dv_ziadatel_meno, def stav ->
    // Nazov casu sa nikde nezadava rucne - sklada sa tu, na jednom mieste,
    // a ZACINA stavom. Predtym stav stal na konci a v zozname sa nedal precitat:
    // stlpec Nazov sa skrati na "Dovolenka 5.10.2026 - 8.1..." a stav odpadne
    // prvy. Vpredu prezije aj skratenie.
    def meno = ((dv_ziadatel_meno.value ?: "") as String).trim()
    def od = as_date(dv_od.value)
    def po = as_date(dv_do.value)
    // Kym termin nie je vyplneny, nema zmysel pisat "Dovolenka <nic>" - case
    // sa v tej chvili vola podla toho, co to je, nie kedy to je.
    def co = (od && po) ? ("Dovolenka " + obdobie(od, po)) : "Žiadosť o dovolenku"
    return (stav as String) + " · " + co + " · " + (meno ?: "?")
}
	]]></function>
	<function scope="process" name="farba"><![CDATA[
{ def stavKod ->
    // Farba casu je to jedine, co je v zozname vidno bez citania - ikona
    // riadku sa ju obarvi. Paleta enginu: red|orange|yellow|green|teal|cyan|
    // blue|indigo|purple|pink|brown|grey.
    def m = ["koncept"      : "grey",     // nic sa este nedeje
             "na_schvalenie": "blue",     // je to v obehu
             "vratena"      : "orange",   // ziadatel ma nieco spravit
             "schvalena"    : "green",
             "zamietnuta"   : "red"]
    return m[stavKod as String] ?: "grey"
}
	]]></function>
	<function scope="process" name="dni_slovom"><![CDATA[
{ def pocet ->
    int n = ((pocet ?: 0) as Number).intValue()
    return n + " " + ((n == 1) ? "deň" : ((n >= 2 && n <= 4) ? "dni" : "dní"))
}
	]]></function>
	<function scope="process" name="zapis_historie"><![CDATA[
{ def dv_historia, def text ->
    // Bez tohto by sa pri druhom kole poznámka vedúceho prepísala a nebolo by
    // vidieť, čo si žiadateľ a vedúci medzi sebou vlastne vymenili. Vzor je
    // `tk_worklog` v sd_ticket.
    def ts = java.time.LocalDateTime.now()
            .format(java.time.format.DateTimeFormatter.ofPattern("d.M.yyyy HH:mm"))
    def log = (dv_historia.value ?: "") as String
    def riadok = ts + "  " + (text as String)
    change dv_historia value { log ? log + "\n" + riadok : riadok }
}
	]]></function>
	<function scope="process" name="as_date"><![CDATA[
{ def raw ->
    // Hodnota `date` poľa je LocalDate, ale cez REST aj z init príde reťazec.
    // Bez tohto by porovnanie dátumov padlo na ClassCastException a akcia by
    // sa zastavila v polovici - časť zmien zapísaná, zvyšok nie.
    if (raw == null) return null
    if (raw instanceof java.time.LocalDate) return raw
    if (raw instanceof java.time.LocalDateTime) return raw.toLocalDate()
    def s = (raw as String).trim()
    if (!s) return null
    try {
        return java.time.LocalDate.parse(s.length() > 10 ? s.substring(0, 10) : s)
    } catch (Exception e) {
        return null
    }
}
	]]></function>
	<function scope="process" name="obdobie"><![CDATA[
{ def od, def po ->
    if (od == null || po == null) return "termín nevyplnený"
    def fmt = java.time.format.DateTimeFormatter.ofPattern("d.M.yyyy")
    return od.format(fmt) + " – " + po.format(fmt)
}
	]]></function>
	<function scope="process" name="prepocet"><![CDATA[
{ def dv_od, def dv_do, def dv_dni, def dv_kontrola ->
    // `do` je v Groovy kľúčové slovo, preto `po`.
    // Vracia true, ak je čo povedať - podľa toho akcia pole odkryje alebo skryje.
    def od = as_date(dv_od.value)
    def po = as_date(dv_do.value)
    if (od == null || po == null) {
        change dv_dni value { null }
        change dv_kontrola value { "" }
        return false
    }
    if (po.isBefore(od)) {
        change dv_dni value { null }
        change dv_kontrola value { "Dátum do je skôr ako dátum od – žiadosť sa takto podať nedá." }
        return true
    }
    change dv_dni value { (java.time.temporal.ChronoUnit.DAYS.between(od, po) + 1) as Double }
    change dv_kontrola value { "" }
    return false
}
	]]></function>
