dv_rozhodnutie: f.dv_rozhodnutie, dv_stav: f.dv_stav, dv_stav_label: f.dv_stav_label,
dv_rozhodol: f.dv_rozhodol, dv_rozhodnute_o: f.dv_rozhodnute_o, dv_poznamka: f.dv_poznamka,
dv_historia: f.dv_historia, dv_od: f.dv_od, dv_do: f.dv_do,
dv_ziadatel_meno: f.dv_ziadatel_meno;

def volba = ((dv_rozhodnutie.value ?: "") as String).trim()
def meno = kto(loggedUser())
def pozn = ((dv_poznamka.value ?: "") as String).trim()

def label = ["schvalena": "Schválená", "zamietnuta": "Zamietnutá",
             "vratena"  : "Vrátená na prerobenie"][volba]

change dv_stav value { volba }
change dv_stav_label value { label }
changeCaseProperty("color").about { farba(volba) }

if (volba == "vratena") {
    zapis_historie(dv_historia, "vrátené na prerobenie (" + meno + "): " + pozn)
} else {
    // Kto a kedy rozhodol sa zapisuje len pri konečnom rozhodnutí. Vrátenie
    // rozhodnutie nie je - žiadosť sa vracia do hry.
    change dv_rozhodol value { meno }
    change dv_rozhodnute_o value { java.time.LocalDateTime.now() }
    zapis_historie(dv_historia,
            (volba == "schvalena" ? "schválené (" : "zamietnuté (") + meno + ")" +
                    (pozn ? ": " + pozn : ""))
}

// Vynulovať výber, inak by pri ďalšom kole (po vrátení a opätovnom podaní)
// bola v selecte predvyplnená minulá voľba a DOKONČIŤ by prešlo bez toho,
// aby sa vedúci na čokoľvek pozrel.
change dv_rozhodnutie value { null }
changeCaseProperty("title").about { nazov(dv_od, dv_do, dv_ziadatel_meno, label) }
				]]></action>
