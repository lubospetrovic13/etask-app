dv_rozhodnutie: f.dv_rozhodnutie, dv_poznamka: f.dv_poznamka,
dv_to_vybavena: f.dv_to_vybavena, dv_to_koncept: f.dv_to_koncept;

// SMEROVANIE MUSÍ BYŤ V phase="pre". Engine vyhodnotí násobnosti variable
// arcov po `pre` a pred `post`; keby sa flagy nastavili v `post`, token by sa
// pohyboval s pôvodnými nulami a nevystrelil by ani jeden arc - case by ostal
// bez tokenu. (docs/petriflow_reference.md, C4)
def volba = ((dv_rozhodnutie.value ?: "") as String).trim()

if (!volba) {
    throw new java.lang.IllegalStateException(
            "Vyberte, či žiadosť schvaľujete, zamietate alebo vraciate na prerobenie.")
}
if (!(volba in ["schvalena", "zamietnuta", "vratena"])) {
    // Bez tohto by neznáma hodnota nechala oba flagy na nule a token by sa
    // z p_na_schvalenie stratil bez toho, aby kdekoľvek pribudol.
    throw new java.lang.IllegalStateException("Neznáme rozhodnutie: " + volba)
}
if (volba == "vratena" && !((dv_poznamka.value ?: "") as String).trim()) {
    // Povinné je to len pri vrátení, takže sa to nedá vyjadriť `required`
    // na dataRefe - ten platí pre všetky tri možnosti naraz.
    throw new java.lang.IllegalStateException("Napíšte, čo má žiadateľ doplniť.")
}

change dv_to_vybavena value { (volba == "vratena" ? 0 : 1) as Double }
change dv_to_koncept  value { (volba == "vratena" ? 1 : 0) as Double }
				]]></action>
			</actions>
			<actions phase="post">
