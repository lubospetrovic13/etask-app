	<transition>
		<id>t_podat</id>
		<x>304</x>
		<y>208</y>
		<label name="t_podat_label">Podať žiadosť</label>
		<icon>send</icon>
		<!-- Osobná úloha na čerstvom case-e - `auto` je v poriadku (B12/B21). -->
		<assignPolicy>auto</assignPolicy>
		<roleRef>
			<id>default</id>
			<logic>
				<perform>true</perform>
			</logic>
		</roleRef>
		<dataGroup>
			<id>g_zadanie</id>
			<cols>6</cols>
			<layout>grid</layout>
			<dataRef>
				<id>div_zadanie</id>
				<logic><behavior>visible</behavior></logic>
				<layout><x>0</x><y>0</y><rows>1</rows><cols>6</cols><template>material</template><appearance>outline</appearance></layout>
				<component><name>divider</name></component>
			</dataRef>
			<dataRef>
				<id>meno_ziadatela</id>
				<logic><behavior>editable</behavior><behavior>required</behavior></logic>
				<layout><x>0</x><y>1</y><rows>1</rows><cols>6</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
			<dataRef>
				<id>suma_uveru</id>
				<logic><behavior>editable</behavior><behavior>required</behavior></logic>
				<layout><x>0</x><y>2</y><rows>1</rows><cols>3</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
			<dataRef>
				<id>prijem</id>
				<logic><behavior>editable</behavior><behavior>required</behavior></logic>
				<layout><x>3</x><y>2</y><rows>1</rows><cols>3</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
			<dataRef>
				<id>skore</id>
				<logic><behavior>editable</behavior><behavior>required</behavior></logic>
				<layout><x>0</x><y>3</y><rows>1</rows><cols>3</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
		</dataGroup>
		<event type="finish">
			<id>t_podat_finish</id>
			<actions phase="pre">
				<action id="2"><![CDATA[
meno_ziadatela: f.meno_ziadatela, suma_uveru: f.suma_uveru, prijem: f.prijem, skore: f.skore;

// Validacie, ktore `required` neoveri. Odmietnutie vrati HTTP 200 a dovod
// v tele ako `error` - test na stavovy kod ho prehliadne.
if (!((meno_ziadatela.value ?: "") as String).trim()) {
    throw new IllegalStateException("Meno žiadateľa musí byť vyplnené.")
}
if (((suma_uveru.value ?: 0) as Double) <= 0) {
    throw new IllegalStateException("Suma úveru musí byť kladné číslo.")
}
if (((prijem.value ?: 0) as Double) <= 0) {
    throw new IllegalStateException("Mesačný príjem musí byť kladné číslo.")
}
def sk = (skore.value ?: 0) as Integer
if (sk < 300 || sk > 900) {
    throw new IllegalStateException("Kreditné skóre musí byť medzi 300 a 900.")
}
				]]></action>
			</actions>
			<actions phase="post">
				<action id="3"><![CDATA[
meno_ziadatela: f.meno_ziadatela, cislo_ziadosti: f.cislo_ziadosti,
podal: f.podal, podane_o: f.podane_o, stav_label: f.stav_label;

change cislo_ziadosti value { (useCase.visualId ?: useCase.stringId) as String }
change podal value { kto(loggedUser()) }
change podane_o value { java.time.LocalDateTime.now() }
change stav_label value { "vyhodnocovanie" }
changeCaseProperty("title").about { nazov(meno_ziadatela) }
changeCaseProperty("color").about { "blue" }

// Jediny system prechod v sieti sa nespusti sam (C3) - nabootuje ho tu ten,
// kto podanie dokoncil. `finishTask` spusti jeho finish udalost, kde je
// cela rozhodovacia logika (nahrada za DMN tabulku z Camunda predlohy).
async.run {
    def t = findTask { qTask -> qTask.transitionId.eq("t_rozhodnutie").and(qTask.caseId.eq(useCase.stringId)) }
    if (t) { assignTask(t, userService.loggedOrSystem); finishTask(t, userService.loggedOrSystem) }
}
				]]></action>
			</actions>
		</event>
	</transition>

	<transition>
		<id>t_rozhodnutie</id>
		<x>688</x>
		<y>208</y>
		<label name="t_rozhodnutie_label">Vyhodnotenie</label>
		<icon>rule</icon>
		<assignPolicy>auto</assignPolicy>
		<!-- System task typu A (gotcha 44) - ziadny dataGroup, spusti ho len async.run vyssie. -->
		<roleRef>
			<id>system</id>
			<logic>
				<perform>true</perform>
			</logic>
		</roleRef>
		<event type="finish">
			<id>t_rozhodnutie_finish</id>
			<actions phase="pre">
				<action id="4"><![CDATA[
skore: f.skore, suma_uveru: f.suma_uveru, prijem: f.prijem, rozhodnutie: f.rozhodnutie,
go_schvalit: f.go_schvalit, go_preskumat: f.go_preskumat, go_zamietnut: f.go_zamietnut;

// "DMN tabulka" z predlohy - kreditne skore a pomer sumy k prijmu. Presne
// jedna vetva sa nastavi na 1, zvysne na 0 (Pattern 2, rozsireny na tri
// vystupy) - routovacie priznaky MUSIA byt v phase="pre" (C4).
def sk = (skore.value ?: 0) as Integer
def suma = (suma_uveru.value ?: 0) as Double
def prijemVal = (prijem.value ?: 0) as Double

def vysledok
if (sk < 500) {
    vysledok = "zamietnut"
} else if (sk >= 700 && suma <= prijemVal * 10) {
    vysledok = "schvalit"
} else {
    vysledok = "preskumat"
}

change rozhodnutie value { vysledok }
change go_schvalit  value { vysledok == "schvalit"  ? 1 : 0 }
change go_preskumat value { vysledok == "preskumat" ? 1 : 0 }
change go_zamietnut value { vysledok == "zamietnut" ? 1 : 0 }
				]]></action>
			</actions>
			<actions phase="post">
				<action id="5"><![CDATA[
rozhodnutie: f.rozhodnutie, stav_label: f.stav_label;

def stavPodla = ["schvalit": "schvalena", "preskumat": "na_preskumani", "zamietnut": "zamietnuta"]
change stav_label value { stavPodla[rozhodnutie.value as String] }
def farba = ["schvalit": "green", "preskumat": "orange", "zamietnut": "red"]
changeCaseProperty("color").about { farba[rozhodnutie.value as String] }
				]]></action>
			</actions>
		</event>
	</transition>

	<transition>
		<id>t_manualne_preskumanie</id>
		<x>1072</x>
		<y>208</y>
		<label name="t_manualne_preskumanie_label">Manuálne posúdenie</label>
		<icon>fact_check</icon>
		<!-- Zdielany prehlad referentov (kohokolvek), takze `manual` - `auto`
		     by ju priradilo systemovemu uctu, ktory ju nabootoval (B12/B21). -->
		<assignPolicy>manual</assignPolicy>
		<roleRef>
			<id>referent</id>
			<logic>
				<perform>true</perform>
			</logic>
		</roleRef>
		<dataGroup>
			<id>g_preskumanie</id>
			<cols>6</cols>
			<layout>grid</layout>
			<dataRef>
				<id>cislo_ziadosti</id>
				<logic><behavior>visible</behavior></logic>
				<layout><x>0</x><y>0</y><rows>1</rows><cols>2</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
			<dataRef>
				<id>meno_ziadatela</id>
				<logic><behavior>visible</behavior></logic>
				<layout><x>2</x><y>0</y><rows>1</rows><cols>4</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
			<dataRef>
				<id>suma_uveru</id>
				<logic><behavior>visible</behavior></logic>
				<layout><x>0</x><y>1</y><rows>1</rows><cols>2</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
			<dataRef>
				<id>prijem</id>
				<logic><behavior>visible</behavior></logic>
				<layout><x>2</x><y>1</y><rows>1</rows><cols>2</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
			<dataRef>
				<id>skore</id>
				<logic><behavior>visible</behavior></logic>
				<layout><x>4</x><y>1</y><rows>1</rows><cols>2</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
			<dataRef>
				<id>rozhodnutie</id>
				<logic><behavior>visible</behavior></logic>
				<layout><x>0</x><y>2</y><rows>1</rows><cols>3</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
			<dataRef>
				<id>div_manualne</id>
				<logic><behavior>visible</behavior></logic>
				<layout><x>0</x><y>3</y><rows>1</rows><cols>6</cols><template>material</template><appearance>outline</appearance></layout>
				<component><name>divider</name></component>
			</dataRef>
			<dataRef>
				<id>komentar_referenta</id>
				<logic><behavior>editable</behavior><behavior>required</behavior></logic>
				<layout><x>0</x><y>4</y><rows>3</rows><cols>6</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
			<dataRef>
				<id>rozhodnutie_referenta</id>
				<logic><behavior>editable</behavior><behavior>required</behavior></logic>
				<layout><x>0</x><y>7</y><rows>1</rows><cols>3</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
		</dataGroup>
		<event type="finish">
			<id>t_manualne_preskumanie_finish</id>
			<actions phase="pre">
				<action id="6"><![CDATA[
komentar_referenta: f.komentar_referenta, rozhodnutie_referenta: f.rozhodnutie_referenta,
go_r_schvalit: f.go_r_schvalit, go_r_zamietnut: f.go_r_zamietnut;

if (!((komentar_referenta.value ?: "") as String).trim()) {
    throw new IllegalStateException("Komentár referenta musí byť vyplnený.")
}
if (rozhodnutie_referenta.value == "schvalit") {
    change go_r_schvalit value { 1 }
    change go_r_zamietnut value { 0 }
} else {
    change go_r_schvalit value { 0 }
    change go_r_zamietnut value { 1 }
