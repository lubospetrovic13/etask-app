doba_splacania: f.doba_splacania;

// Validacie, ktore `required` neoveri. Odmietnutie vrati HTTP 200 a dovod
// v tele ako `error` - test na stavovy kod ho prehliadne.
if (!((meno_ziadatela.value ?: "") as String).trim()) {
    throw new IllegalStateException("The applicant name must be filled in.")
}
if (((suma_uveru.value ?: 0) as Double) <= 0) {
    throw new IllegalStateException("The loan amount must be a positive number.")
}
if (((prijem.value ?: 0) as Double) <= 0) {
    throw new IllegalStateException("The monthly income must be a positive number.")
}
def sk = (skore.value ?: 0) as Integer
if (sk < 300 || sk > 900) {
    throw new IllegalStateException("The credit score must be between 300 and 900.")
}
def mes = (doba_splacania.value ?: 0) as Integer
if (mes < 12 || mes > 360) {
    throw new IllegalStateException("The repayment period must be between 12 and 360 months.")
}
