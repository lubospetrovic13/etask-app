		bez oboch polovic sa zobrazi povodna hodnota a nic to nepovie.
		Kod jazyka musi byt DVOJPISMENOVY - `en-US` sa naimportuje
		a nikdy sa nepouzije (ENGINE_ISSUES E15).
	-->
	<i18n locale="en">
		<i18nString name="net_title">Loan application</i18nString>
		<i18nString name="referent_title">Loan officer</i18nString>
		<i18nString name="system_title">System</i18nString>
		<i18nString name="div_zadanie_init">Application details</i18nString>
		<i18nString name="div_manualne_init">Manual review</i18nString>
		<i18nString name="meno_ziadatela_title">Applicant name</i18nString>
		<i18nString name="suma_uveru_title">Loan amount (EUR)</i18nString>
		<i18nString name="prijem_title">Monthly income (EUR)</i18nString>
		<i18nString name="skore_title">Credit score (300-900)</i18nString>
		<i18nString name="skore_desc">A whole number from 300 to 900.</i18nString>
		<i18nString name="cislo_ziadosti_title">Application number</i18nString>
		<i18nString name="ziadatel_title">Applicant</i18nString>
		<i18nString name="podal_title">Submitted by</i18nString>
