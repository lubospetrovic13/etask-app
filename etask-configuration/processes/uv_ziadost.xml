			<id>t_riaditel_finish</id>
			<actions phase="pre">
				<action id="12"><![CDATA[
rozhodnutie_riaditela: f.rozhodnutie_riaditela,
go_d_schvalit: f.go_d_schvalit, go_d_zamietnut: f.go_d_zamietnut;

def volba = rozhodnutie_riaditela.value as String
if (volba != "schvalit" && volba != "zamietnut") {
    throw new IllegalStateException("The director must pick approve or reject.")
}
change go_d_schvalit  value { volba == "schvalit" ? 1 : 0 }
change go_d_zamietnut value { volba == "zamietnut" ? 1 : 0 }
				]]></action>
			</actions>
			<actions phase="post">
				<action id="13"><![CDATA[
rozhodnutie_riaditela: f.rozhodnutie_riaditela, stav_label: f.stav_label,
vybavil: f.vybavil, vybavene_o: f.vybavene_o;

change vybavil value { kto(loggedUser()) }
change vybavene_o value { java.time.LocalDateTime.now() }
change stav_label value { rozhodnutie_riaditela.value == "schvalit" ? "schvalena" : "zamietnuta" }
changeCaseProperty("color").about { rozhodnutie_riaditela.value == "schvalit" ? "green" : "red" }
				]]></action>
			</actions>
		</event>
