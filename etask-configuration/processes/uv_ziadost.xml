	<function scope="process" name="sadzba_podla_skore"><![CDATA[
{ def sk ->
    // Urokova sadzba podla kreditneho skore. Nie je to ceninik banky, je to
    // ukazka - ale je monotonna a spojita v pasmach, takze sa na nej da
    // ukazat, preco vyssie skore znamena nizsiu splatku a tym nizsie DTI.
    int v = (sk ?: 0) as Integer
    if (v >= 800) return 5.9d
    if (v >= 700) return 7.9d
    if (v >= 600) return 10.9d
    if (v >= 500) return 14.9d
    return 19.9d
}
	]]></function>
	<function scope="process" name="anuita"><![CDATA[
{ def suma, def sadzbaRocna, def mesiacov ->
    // Anuitna splatka: s * i / (1 - (1+i)^-n), kde i je MESACNA sadzba.
    // Nulova sadzba by delila nulou, preto vetva - a nulova sa da nastavit,
    // ked niekto zmeni `sadzba_podla_skore`.
    double s = (suma ?: 0) as Double
    double r = (sadzbaRocna ?: 0) as Double
    int n = (mesiacov ?: 0) as Integer
    if (s <= 0 || n <= 0) return 0.0d
    double i = r / 100.0d / 12.0d
    if (i <= 0) return Math.round((s / n) * 100.0d) / 100.0d
    double v = s * i / (1.0d - Math.pow(1.0d + i, -n))
    return Math.round(v * 100.0d) / 100.0d
}
	]]></function>
	<function scope="process" name="pasmo_dti"><![CDATA[
{ def hodnota ->
    double d = (hodnota ?: 0) as Double
    if (d <= 30.0d) return "ok"
    if (d <= 45.0d) return "hranicne"
    return "vysoke"
}
	]]></function>
	<function scope="process" name="limit_uveru"><![CDATA[
{ ->
    // Nad tuto sumu podpisuje este riaditel. Zije vo VLASTNEJ konfiguracii
    // uveru, nie v `admin/nastavenia/sc_nastavenia`: tamta siet patri aplikacii
    // Objednavky a faktury, ktora zije vo vlastnom repe - zavislost by isla
    // obratenym smerom a `pfapp install` by to pole raz ticho zmazal.
    // Ked konfiguracia neexistuje alebo je prazdna, plati zabudovanych 50 000:
    // appka musi fungovat aj tam, kde konfiguracnu siet nikto nenaimportoval.
    def cfg = najnovsiCase("financie/uver/uv_nastavenia")
    def v = cfg?.dataSet?.get("uvn_limit")?.value
    if (v == null) return 50000.0d
    double d = (v as Number).doubleValue()
    return d > 0 ? d : 50000.0d
}
	]]></function>
	<function scope="process" name="prepocet"><![CDATA[
{ def suma_uveru, def prijem, def skore, def doba_splacania,
  def urok_sadzba, def splatka, def dti, def dti_pasmo, def vypocet ->
    // KALKULACKA. Vola sa z `set` udalosti kazdeho vstupu, takze ziadatel vidi
    // splatku aj DTI hned pri pisani - a z `t_rozhodnutie`, aby rozhodnutie
    // nikdy nestalo na cisle, ktore niekto medzitym prepisal.
    double suma = ((suma_uveru.value ?: 0) as Number).doubleValue()
    double prijemVal = ((prijem.value ?: 0) as Number).doubleValue()
    int sk = ((skore.value ?: 0) as Number).intValue()
    int mes = ((doba_splacania.value ?: 0) as Number).intValue()

    double sadzba = sadzba_podla_skore(sk)
    double mesacne = anuita(suma, sadzba, mes)
    double pomer = (prijemVal > 0) ? (Math.round(mesacne / prijemVal * 1000.0d) / 10.0d) : 0.0d

    change urok_sadzba value { sadzba }
    change splatka value { mesacne }
    change dti value { pomer }
    change dti_pasmo value { pasmo_dti(pomer) }

    // Hodnoty datovych poli su po ANGLICKY - aplikacia ma anglictinu ako
    // default a tieto retazce nemaju preklad, takze slovenska veta by na
    // anglickom portali trcala uprostred formulara.
    def riadky = []
    if (suma <= 0 || mes <= 0 || prijemVal <= 0) {
        riadky << "Fill in the amount, income and repayment period - then the instalment can be worked out."
    } else {
        riadky << ("Score " + sk + " -> interest " + sadzba + " % p.a.")
        riadky << ("Loan " + suma + " EUR over " + mes + " months -> instalment " + mesacne + " EUR per month")
        riadky << ("Instalment " + mesacne + " EUR of income " + prijemVal + " EUR -> DTI " + pomer + " %")
    }
    change vypocet value { riadky.join("\n") }
    return pomer
}
	]]></function>
