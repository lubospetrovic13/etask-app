	</i18n>
	<icon>account_balance</icon>
	<defaultRole>true</defaultRole>
	<anonymousRole>false</anonymousRole>
	<transitionRole>false</transitionRole>
	<!--
		Žiadosť o úver: entita (RUNBOOK 7), nie úkon - jeden case = jedna
		žiadosť po celý jej život (podanie -> automatické rozhodnutie ->
		prípadné manuálne posúdenie -> schválená/zamietnutá).

		Tri vrstvy rozhodovania podľa BPMN/DMN predlohy (Camunda) prevedené
		do Petriflow bez DMN enginu - "DMN tabuľka" je tu čistý Groovy vo
		`finish pre` systémového prechodu `t_rozhodnutie`, ktorý podľa skóre
		a pomeru suma/príjem nastaví trojicu routovacích čísel a token ide
		presne jednou z troch vetiev (Pattern 2 z petriflow_reference.md,
		rozšírený na tri vetvy).

		`t_prehlad` visí na read arc zo SINKU `p_detail`, ktorý nikto
		nekonzumuje (B8b) - žiadateľ tak vidí stav žiadosti po celý jej
		život, aj keď hlavný tok je už dávno v `p_schvalena`/`p_zamietnuta`.
		Viditeľnosť je zúžená na referentov (rola) a samotného žiadateľa
		(`userRef` na `ziadatel` - Pattern 20), nie na celú rolu `default`,
		inak by každý prihlásený videl cudzie žiadosti.
	-->
	<caseEvents>
		<event type="create">
			<id>uv_create</id>
			<actions phase="post">
				<action id="1"><![CDATA[
stav_label: f.stav_label, ziadatel: f.ziadatel;

change stav_label value { "rozpisane" }
change ziadatel value { [loggedUser().id] }
changeCaseProperty("title").about { "Nová žiadosť o úver" }
changeCaseProperty("color").about { "grey" }
				]]></action>
			</actions>
		</event>
	</caseEvents>
	<function scope="process" name="kto"><![CDATA[
{ def u ->
    // `?.` chráni pred null, nie pred chýbajúcou property.
    return (u.hasProperty("fullName") && u.fullName) ? (u.fullName as String) : (u.email as String)
}
	]]></function>
	<function scope="process" name="nazov"><![CDATA[
{ def pole ->
    // BEZ STAVU: `Case.title` je v engine obycajny `String`, takze sa
    // neprekladá. Stav nesie pole `stav_label` a stĺpec, nie názov prípadu.
    def p = ((pole.value ?: "") as String).trim()
    return p ?: ((useCase.visualId ?: "?") as String)
}
	]]></function>
