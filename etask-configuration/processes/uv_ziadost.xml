			<actions phase="pre">
				<action id="4"><![CDATA[
skore: f.skore, suma_uveru: f.suma_uveru, prijem: f.prijem, rozhodnutie: f.rozhodnutie,
doba_splacania: f.doba_splacania, urok_sadzba: f.urok_sadzba, splatka: f.splatka,
dti: f.dti, dti_pasmo: f.dti_pasmo, vypocet: f.vypocet,
go_schvalit: f.go_schvalit, go_riaditel: f.go_riaditel,
go_preskumat: f.go_preskumat, go_zamietnut: f.go_zamietnut;

// KALKULACKA SA PREPOCITA ZNOVA, aj ked ju formular pocital pri kazdom
// stlaceni klavesu. Rozhodnutie nesmie stat na cisle, ktore niekto medzitym
// prepisal cez API - vstupy su `suma`, `prijem`, `skore` a `doba`, vystupy
// dopocita siet sama.
def pomer = prepocet(suma_uveru, prijem, skore, doba_splacania,
                     urok_sadzba, splatka, dti, dti_pasmo, vypocet)

// "DMN tabulka": kreditne skore a DTI. Presne jedna vetva sa nastavi na 1,
// zvysne na 0 (Pattern 2, rozsireny na styri vystupy) - routovacie priznaky
// MUSIA byt v phase="pre" (C4), v `post` by sa token pohol s nulami a zmizol.
//
// Poradie podmienok je poradie prisnosti: co zamietne skore, uz sa DTI
// nepyta, a co neunesie DTI, nezachrani ani vyborne skore.
def sk = (skore.value ?: 0) as Integer
def suma = ((suma_uveru.value ?: 0) as Number).doubleValue()
def pasmo = pasmo_dti(pomer)
def limit = limit_uveru()

def vysledok
if (sk < 500) {
    vysledok = "zamietnut"
} else if (pasmo == "vysoke") {
    vysledok = "zamietnut"
} else if (pasmo == "ok" && sk >= 700) {
    // Jednoznacny pripad - automat ho uzavrie sam. Nad limitom ho vsak este
    // podpisuje riaditel; to nie je pochybnost o ziadosti, je to suma.
    vysledok = (suma > limit) ? "riaditel" : "schvalit"
} else {
    vysledok = "preskumat"
}

change rozhodnutie value { vysledok }
change go_schvalit  value { vysledok == "schvalit"  ? 1 : 0 }
change go_riaditel  value { vysledok == "riaditel"  ? 1 : 0 }
change go_preskumat value { vysledok == "preskumat" ? 1 : 0 }
change go_zamietnut value { vysledok == "zamietnut" ? 1 : 0 }
				]]></action>
			</actions>
			<actions phase="post">
				<action id="5"><![CDATA[
rozhodnutie: f.rozhodnutie, stav_label: f.stav_label;

def stavPodla = ["schvalit": "schvalena", "riaditel": "u_riaditela",
                 "preskumat": "na_preskumani", "zamietnut": "zamietnuta"]
change stav_label value { stavPodla[rozhodnutie.value as String] }
def farba = ["schvalit": "green", "riaditel": "orange",
             "preskumat": "orange", "zamietnut": "red"]
changeCaseProperty("color").about { farba[rozhodnutie.value as String] }
				]]></action>
			</actions>
		</event>
	</transition>

