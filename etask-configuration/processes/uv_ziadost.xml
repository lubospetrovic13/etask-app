    throw new IllegalStateException("The reviewer comment must be filled in.")
}

// Nad limitom podpisuje este riaditel - aj ked referent schvalil. Referent
// si to moze vybrat aj sam (volba "Schváliť a poslať riaditeľovi"), ale nad
// limitom to NIE JE jeho volba: suma rozhoduje, nie nazor.
def suma = ((suma_uveru.value ?: 0) as Number).doubleValue()
def kam = rozhodnutie_referenta.value as String
