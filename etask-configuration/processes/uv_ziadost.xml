			<create>true</create>
			<view>true</view>
		</caseLogic>
	</roleRef>
	<roleRef>
		<id>referent</id>
		<caseLogic>
			<view>true</view>
		</caseLogic>
	</roleRef>
	<roleRef>
		<id>system</id>
		<caseLogic>
			<view>true</view>
		</caseLogic>
	</roleRef>
	<userRef>
		<id>ziadatel</id>
		<caseLogic>
			<view>true</view>
		</caseLogic>
	</userRef>
	<role>
		<id>referent</id>
		<title name="referent_title">Úverový referent</title>
	</role>
	<role>
