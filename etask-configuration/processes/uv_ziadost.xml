change podal value { kto(loggedUser()) }
change podane_o value { java.time.LocalDateTime.now() }
change stav_label value { "vyhodnocovanie" }
changeCaseProperty("title").about { nazov(meno_ziadatela) }
changeCaseProperty("color").about { "blue" }

// Jediny system prechod v sieti sa nespusti sam (C3) - nabootuje ho tu ten,
// kto podanie dokoncil. `finishTask` spusti jeho finish udalost, kde je
// cela rozhodovacia logika (nahrada za DMN tabulku z Camunda predlohy).
async.run {
    def t = findTask { qTask -> qTask.transitionId.eq("t_rozhodnutie").and(qTask.caseId.eq(useCase.stringId)) }
    if (t) { assignTask(t, userService.loggedOrSystem); finishTask(t, userService.loggedOrSystem) }
}
