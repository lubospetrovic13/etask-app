		<i18nString name="stav_label_opt_rozpisane">Draft</i18nString>
		<i18nString name="stav_label_opt_vyhodnocovanie">Being evaluated</i18nString>
		<i18nString name="stav_label_opt_na_preskumani">In manual review</i18nString>
		<i18nString name="stav_label_opt_schvalena">Approved</i18nString>
		<i18nString name="stav_label_opt_zamietnuta">Rejected</i18nString>
		<i18nString name="rozhodnutie_title">Automated decision</i18nString>
		<i18nString name="rozhodnutie_desc">Set by the credit-scoring rule. Not editable by hand.</i18nString>
		<i18nString name="rozhodnutie_opt_schvalit">Approve</i18nString>
