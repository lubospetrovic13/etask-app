			<id>t_on_podanie_finish</id>
			<title name="t_on_podanie_finish_t">Podať</title>
			<actions phase="pre">
				<action id="2"><![CDATA[
on_meno: f.on_meno, on_pozicia: f.on_pozicia, on_datum_nastupu: f.on_datum_nastupu,
on_nadriadeny: f.on_nadriadeny;

// Sem validacie, ktore `required` neoveri. Odmietnutie vrati HTTP 200
// a dovod v tele ako `error` - test na stavovy kod taky blok prehliadne.
if (!((on_meno.value ?: "") as String).trim()) {
    throw new java.lang.IllegalStateException("Meno nastupujúceho musí byť vyplnené.")
}
if (!((on_pozicia.value ?: "") as String).trim()) {
    throw new java.lang.IllegalStateException("Pozícia musí byť vyplnená.")
}
if (on_datum_nastupu.value == null) {
    throw new java.lang.IllegalStateException("Dátum nástupu musí byť vyplnený.")
}

// Rola zostava autoritativna. `roleRef` a `userRef` sa na prechode ZJEDNOCUJU,
// takze "potvrdi to nadriadeny TOHTO nastupu" sa deklarativne napisat neda -
// smerovanie ide cez `userRef on_nadriadeny` a rolu overuje tento guard.
// `usersWithRole` je prienik: zo zadanych ludi vrati tych, co rolu maju.
def vybrani = userIdsOf(on_nadriadeny.value)
if (!vybrani) {
    throw new java.lang.IllegalStateException("Nadriadený musí byť vybraný - bez neho nemá kto potvrdiť deň nástupu.")
}
if (vybrani.size() > 1) {
    throw new java.lang.IllegalStateException("Nadriadený musí byť práve jeden.")
}
if (!usersWithRole(on_nadriadeny.value, "nadriadeny")) {
    throw new java.lang.IllegalStateException("Vybraná osoba nemá rolu Nadriadený, takže by úlohu v deň nástupu neuvidela.")
}
				]]></action>
			</actions>
			<actions phase="post">
