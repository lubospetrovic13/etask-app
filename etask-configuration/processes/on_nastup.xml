	<!--
		HR poda nastup. Podanie rozdeli zeton do TROCH miest naraz (AND-split),
		takze tri vetvy bezia paralelne, kazda pre svoju rolu. `t_on_den_nastupu`
		ma tri REGULAR vstupne obluky (AND-join), takze ho engine povoli az ked
		ma zeton kazde z troch miest - "kym nie su hotove vsetky tri, neda sa
		dokoncit" je teda vlastnost SIETE, nie guard v Groovy, ktory by sa dal
		obist alebo zabudnut.

		  p_novy - t_on_podanie -+- p_it  - t_on_it       - p_it_ok  -+
		                         +- p_hr  - t_on_hr       - p_hr_ok  -+- t_on_den_nastupu - p_hotovy
		                         +- p_maj - t_on_majetok  - p_maj_ok -+

		  p_alive (zeton od zalozenia, NIKTO ho nekonzumuje) -read- t_on_prehlad

		`p_alive` je vzor z PETRIFLOW_LEARNINGS B25: zadavatel po podani nema
		ziadnu vlastnu ulohu, takze bez tohto miesta nema kde precitat, v akom
		stave jeho pripad je. Miesto, ktore ziadny prechod nekonzumuje, drzi
		`t_on_prehlad` povoleny cely zivot pripadu - a odmietnute DOKONCIT na
		inom prechode ho nezmaze (to je B8b).

		Stav je SAMOSTATNE POLE s `immediate="true"`, nie len poloha tokenu:
		inak sa neda dat do stlpca zoznamu ani podla neho hladat. A su to
		`enumeration_map` polia, nie `text`: `TextField` drzi obycajny `String`,
		ktory engine neprelozi. "Na ktoru vetvu sa caka" preto nesu TRI stavove
		polia (`on_it_stav`, `on_hr_stav`, `on_maj_stav`) - prelozitelne,
		stlpcovatelne a dopytovatelne podla KLUCA, nezavisle od jazyka.

		Kto potvrdzuje den nastupu, sa deklarativne roleRefom napisat neda:
		`roleRef` a `userRef` sa ZJEDNOCUJU, nie prienikaju (RUNBOOK 11). Preto
		je na `t_on_den_nastupu` iba `userRef on_nadriadeny` a rola `nadriadeny`
		zostava autoritativna tym, ze podanie overi, ci ju vybrana osoba ma.
	-->
	<caseEvents>
		<event type="create">
			<id>on_create</id>
			<actions phase="post">
				<action id="1"><![CDATA[
on_stav_label: f.on_stav_label, on_meno: f.on_meno, on_pozicia: f.on_pozicia;

// KLUC moznosti, nie popisok - popisok si engine prelozi sam.
change on_stav_label value { "rozpisane" }
changeCaseProperty("title").about { nazov(on_meno, on_pozicia) }
changeCaseProperty("color").about { "grey" }
				]]></action>
			</actions>
		</event>
	</caseEvents>
	<function scope="process" name="kto"><![CDATA[
{ def u ->
    // `?.` chráni pred null, nie pred chýbajúcou property.
    return (u.hasProperty("fullName") && u.fullName) ? (u.fullName as String) : (u.email as String)
}
	]]></function>
	<function scope="process" name="nazov"><![CDATA[
{ def meno, def pozicia ->
    // BEZ STAVU: `Case.title` je v engine obycajny `String`, takze sa
    // neprekladá - slovensky stav v nazve by bol v anglickom portali jedina
    // slovenska vec v kazdom zozname. Stav nesie pole `on_stav_label`.
    //
    // Kym meno nie je vyplnene, nazov nesie cislo pripadu (`visualId`) - to je
    // lepsie nez prazdny riadok v zozname.
    def m = ((meno.value ?: "") as String).trim()
    def p = ((pozicia.value ?: "") as String).trim()
    if (!m) return ((useCase.visualId ?: "?") as String)
    return p ? (m + " · " + p) : m
}
	]]></function>
	<function scope="process" name="zapis"><![CDATA[
{ def pole, def riadok ->
    // Priebeh drzi MENA ludi, nie nazvy roli: `text` pole je String, ktory sa
    // neprekladá, a meno je jazykovo neutralne (B25).
    def ts = java.time.LocalDateTime.now()
            .format(java.time.format.DateTimeFormatter.ofPattern("dd.MM.yyyy HH:mm"))
    def doteraz = ((pole.value ?: "") as String)
    change pole value { (doteraz ? doteraz + "\n" : "") + ts + " · " + riadok }
}
	]]></function>
	<function scope="process" name="vetvy_hotove"><![CDATA[
{ def a, def b ->
    // Dopocitanie stavu pripadu po dokonceni vetvy. Volajuci sem posiela
    // stavove polia ZVYSNYCH DVOCH vetiev - to svoje prave prepisal a `change`
    // sa do `.value` v tej istej akcii spolahlivo nepremietne.
    return (((a.value ?: "") as String) == "hotovo") && (((b.value ?: "") as String) == "hotovo")
}
	]]></function>
