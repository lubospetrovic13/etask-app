on_meno: f.on_meno, on_pozicia: f.on_pozicia, on_stav_label: f.on_stav_label,
on_it_stav: f.on_it_stav, on_hr_stav: f.on_hr_stav, on_maj_stav: f.on_maj_stav,
on_podal: f.on_podal, on_podane_o: f.on_podane_o, on_priebeh: f.on_priebeh;

change on_stav_label value { "prebieha" }
// Tri vetvy startuju naraz - zeton sa z podania rozdeli do troch miest.
