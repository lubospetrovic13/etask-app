change on_hr_stav value { "caka" }
change on_maj_stav value { "caka" }
change on_podal value { kto(loggedUser()) }
change on_podane_o value { java.time.LocalDateTime.now() }
zapis(on_priebeh, "Nástup podaný — " + kto(loggedUser()))
changeCaseProperty("title").about { nazov(on_meno, on_pozicia) }
changeCaseProperty("color").about { "blue" }
				]]></action>
