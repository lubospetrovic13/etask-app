<document xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://petriflow.com/petriflow.schema.xsd">
	<id>majetok/ma_zariadenie</id>
	<version>1.0.0</version>
	<initials>EZX</initials>
	<title name="net_title">Evidencia zariadení</title>

	<!--
		Preklady. Kluc je atribut `name` na prelozitelnom elemente;
		bez oboch polovic sa zobrazi povodna hodnota a nic to nepovie.
		Kod jazyka musi byt DVOJPISMENOVY - `en-US` sa naimportuje
		a nikdy sa nepouzije (ENGINE_ISSUES E15).
	-->
	<i18n locale="en">
		<i18nString name="net_title">TODO Evidencia zariadení</i18nString>
		<i18nString name="spravca_majetku_title">TODO Spravca_majetku</i18nString>
		<i18nString name="div_ma_zadanie_init">Brief</i18nString>
		<i18nString name="div_ma_vysledok_init">Result</i18nString>
		<i18nString name="ma_predmet_title">Subject</i18nString>
		<i18nString name="ma_popis_title">Description</i18nString>
		<i18nString name="ma_stav_label_title">Status</i18nString>
		<i18nString name="ma_stav_label_desc">A field of its own, so it can be a column and be searched on.</i18nString>
		<i18nString name="ma_podal_title">Submitted by</i18nString>
		<i18nString name="ma_podane_o_title">Submitted</i18nString>
		<i18nString name="t_ma_podanie_label">Submission</i18nString>
		<i18nString name="t_ma_prehlad_label">Submitted</i18nString>
	</i18n>
	<icon>assignment</icon>
	<defaultRole>false</defaultRole>
	<anonymousRole>false</anonymousRole>
	<transitionRole>false</transitionRole>
	<!--
		Skelet z tools/pfnew.py. Domenova logika sa dopisuje, vzory nizsie sa
		nemenia bez dovodu - kazdy z nich je tu kvoli konkretnej tichej pasci.

		  p_novy -> t_ma_podanie -> p_hotovy

		Stav je SAMOSTATNE POLE s `immediate="true"`, nie len poloha tokenu:
		inak sa neda dat do stlpca zoznamu ani podla neho hladat. Nazov pripadu
		zacina stavom, lebo stlpec Nazov sa v zozname skracuje a odpada koniec.

		Ked pridas dalsiu ulohu, NEVES ju na read arc z miesta, ktore nejaky
		prechod konzumuje - odmietnute DOKONCIT ju zmaze a neobnovi
		(PETRIFLOW_LEARNINGS B8b). Bud sink, alebo cast tej istej ulohy.
	-->
	<caseEvents>
		<event type="create">
			<id>ma_create</id>
			<actions phase="post">
				<action id="1"><![CDATA[
ma_stav_label: f.ma_stav_label, ma_predmet: f.ma_predmet;

change ma_stav_label value { "Rozpísané" }
changeCaseProperty("title").about { nazov(ma_predmet, "Rozpísané") }
changeCaseProperty("color").about { "grey" }
				]]></action>
			</actions>
		</event>
	</caseEvents>
	<function scope="process" name="kto"><![CDATA[
{ def u ->
    // `?.` chráni pred null, nie pred chýbajúcou property.
    return (u.hasProperty("fullName") && u.fullName) ? (u.fullName as String) : (u.email as String)
}
	]]></function>
	<function scope="process" name="nazov"><![CDATA[
{ def pole, def stav ->
    // Stav je na ZACIATKU: stlpec Nazov sa v zozname skracuje a to, co je na
    // konci, odpadne prve.
    def p = ((pole.value ?: "") as String).trim()
    return (stav as String) + " · " + (p ?: "Evidencia zariadení")
}
	]]></function>
	<roleRef>
		<id>spravca_majetku</id>
		<caseLogic>
			<create>true</create>
			<view>true</view>
		</caseLogic>
	</roleRef>
	<role>
		<id>spravca_majetku</id>
		<title name="spravca_majetku_title">Spravca_majetku</title>
	</role>
	<data type="i18n">
		<id>div_ma_zadanie</id>
		<title/>
		<init name="div_ma_zadanie_init">Zadanie</init>
	</data>
	<data type="i18n">
		<id>div_ma_vysledok</id>
		<title/>
		<init name="div_ma_vysledok_init">Výsledok</init>
	</data>
	<data type="text" immediate="true">
		<id>ma_predmet</id>
		<title name="ma_predmet_title">Predmet</title>
	</data>
	<data type="text">
		<id>ma_popis</id>
		<title name="ma_popis_title">Popis</title>
		<component>
			<name>textarea</name>
		</component>
	</data>
	<data type="text" immediate="true">
		<id>ma_stav_label</id>
		<title name="ma_stav_label_title">Stav</title>
		<desc name="ma_stav_label_desc">Samostatné pole, aby sa dalo dať do stĺpca a hľadať podľa neho.</desc>
	</data>
	<data type="text">
		<id>ma_podal</id>
		<title name="ma_podal_title">Podal</title>
	</data>
	<data type="dateTime">
		<id>ma_podane_o</id>
		<title name="ma_podane_o_title">Podané</title>
	</data>
	<transition>
		<id>t_ma_podanie</id>
		<x>140</x>
		<y>80</y>
		<label name="t_ma_podanie_label">Podanie</label>
		<icon>assignment</icon>
		<!--
			`auto` je v poriadku na OSOBNU ulohu jedneho aktera. Na zdielanu
			(pult, front, prepazka) patri `manual` - auto ju priradi tomu, kto
			ju vyrobil (PETRIFLOW_LEARNINGS B21).
		-->
		<assignPolicy>auto</assignPolicy>
		<roleRef>
			<id>spravca_majetku</id>
			<!--
				`perform` je skratka pre assign+cancel+finish+view+set,
				`delegate` v nej NIE JE. `cancel` nezakazuj - uvolnuje ulohu,
				nerusi ju.
			-->
			<logic>
				<perform>true</perform>
			</logic>
		</roleRef>
		<dataGroup>
			<id>g_ma_zadanie</id>
			<cols>6</cols>
			<layout>grid</layout>
			<dataRef>
				<id>div_ma_zadanie</id>
				<logic><behavior>visible</behavior></logic>
				<layout><x>0</x><y>0</y><rows>1</rows><cols>6</cols><template>material</template><appearance>outline</appearance></layout>
				<component><name>divider</name></component>
			</dataRef>
			<dataRef>
				<id>ma_predmet</id>
				<logic><behavior>editable</behavior><behavior>required</behavior></logic>
				<layout><x>0</x><y>1</y><rows>1</rows><cols>6</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
			<dataRef>
				<id>ma_popis</id>
				<logic><behavior>editable</behavior></logic>
				<layout><x>0</x><y>2</y><rows>3</rows><cols>6</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
		</dataGroup>
		<event type="finish">
			<id>t_ma_podanie_finish</id>
			<actions phase="pre">
				<action id="2"><![CDATA[
ma_predmet: f.ma_predmet;

// Sem validacie, ktore `required` neoveri. Odmietnutie vrati HTTP 200
// a dovod v tele ako `error` - test na stavovy kod ho prehliadne.
if (!((ma_predmet.value ?: "") as String).trim()) {
    throw new java.lang.IllegalStateException("Predmet musí byť vyplnený.")
}
				]]></action>
			</actions>
			<actions phase="post">
				<action id="3"><![CDATA[
ma_predmet: f.ma_predmet, ma_stav_label: f.ma_stav_label,
ma_podal: f.ma_podal, ma_podane_o: f.ma_podane_o;

change ma_stav_label value { "Podané" }
change ma_podal value { kto(loggedUser()) }
change ma_podane_o value { java.time.LocalDateTime.now() }
changeCaseProperty("title").about { nazov(ma_predmet, "Podané") }
changeCaseProperty("color").about { "green" }
				]]></action>
			</actions>
		</event>
	</transition>
	<transition>
		<id>t_ma_prehlad</id>
		<x>332</x>
		<y>80</y>
		<label name="t_ma_prehlad_label">Podané</label>
		<icon>fact_check</icon>
		<assignPolicy>auto</assignPolicy>
		<!--
			Read arc z `p_hotovy`, ktore je SINK - nikto ho nekonzumuje, takze
			tento pohlad nemoze zmiznut po odmietnutom DOKONCIT (B8b).
		-->
		<roleRef>
			<id>spravca_majetku</id>
			<logic>
				<perform>true</perform>
			</logic>
		</roleRef>
		<dataGroup>
			<id>g_ma_prehlad</id>
			<cols>6</cols>
			<layout>grid</layout>
			<dataRef>
				<id>ma_stav_label</id>
				<logic><behavior>visible</behavior></logic>
				<layout><x>0</x><y>0</y><rows>1</rows><cols>2</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
			<dataRef>
				<id>ma_predmet</id>
				<logic><behavior>visible</behavior></logic>
				<layout><x>2</x><y>0</y><rows>1</rows><cols>4</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
			<dataRef>
				<id>div_ma_vysledok</id>
				<logic><behavior>visible</behavior></logic>
				<layout><x>0</x><y>1</y><rows>1</rows><cols>6</cols><template>material</template><appearance>outline</appearance></layout>
				<component><name>divider</name></component>
			</dataRef>
			<dataRef>
				<id>ma_popis</id>
				<logic><behavior>visible</behavior></logic>
				<layout><x>0</x><y>2</y><rows>3</rows><cols>6</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
			<dataRef>
				<id>ma_podal</id>
				<logic><behavior>visible</behavior></logic>
				<layout><x>0</x><y>5</y><rows>1</rows><cols>3</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
			<dataRef>
				<id>ma_podane_o</id>
				<logic><behavior>visible</behavior></logic>
				<layout><x>3</x><y>5</y><rows>1</rows><cols>3</cols><template>material</template><appearance>outline</appearance></layout>
			</dataRef>
		</dataGroup>
	</transition>
	<place>
		<id>p_novy</id>
		<x>40</x>
		<y>80</y>
		<label>Rozpísané</label>
		<tokens>1</tokens>
		<static>false</static>
	</place>
	<place>
		<id>p_hotovy</id>
		<x>236</x>
		<y>80</y>
		<label>Podané</label>
		<tokens>0</tokens>
		<static>false</static>
	</place>
	<arc>
		<id>a_ma_podanie_in</id>
		<type>regular</type>
		<sourceId>p_novy</sourceId>
		<destinationId>t_ma_podanie</destinationId>
		<multiplicity>1</multiplicity>
	</arc>
	<arc>
		<id>a_ma_podanie_out</id>
		<type>regular</type>
		<sourceId>t_ma_podanie</sourceId>
		<destinationId>p_hotovy</destinationId>
		<multiplicity>1</multiplicity>
	</arc>
	<arc>
		<id>a_ma_prehlad</id>
		<type>read</type>
		<sourceId>p_hotovy</sourceId>
		<destinationId>t_ma_prehlad</destinationId>
		<multiplicity>1</multiplicity>
	</arc>
</document>
