		<event type="finish">
			<id>t_on_request_finish</id>
			<title name="t_on_request_finish_t">Submit for approval</title>
			<actions phase="pre">
				<action id="2"><![CDATA[
on_first_name: f.on_first_name, on_last_name: f.on_last_name, on_email: f.on_email,
on_position: f.on_position, on_cost_centre: f.on_cost_centre, on_start_date: f.on_start_date,
on_approver: f.on_approver, on_requester: f.on_requester;

// Jediné miesto, ktoré podanie naozaj zastaví. `required` overí len to, že
// pole nie je prázdne; toto overí, že to dáva zmysel. Výnimka v phase="pre"
// zruší dokončenie prechodu, takže token zostane v p_draft.
//
// POZOR: odmietnutie príde ako HTTP 200 s dôvodom v tele (`error`), nie ako
// 4xx - test na stavový kód taký blok prehliadne.
def povinne = [["First name", on_first_name], ["Last name", on_last_name],
               ["Work e-mail", on_email], ["Position", on_position],
               ["Cost centre", on_cost_centre]]
povinne.each { par ->
    if (!(((par[1].value ?: "") as String).trim())) {
        throw new java.lang.IllegalStateException("Fill in: " + par[0] + ".")
    }
}
if (on_start_date.value == null) {
    throw new java.lang.IllegalStateException("Fill in the start date.")
}
def mail = ((on_email.value ?: "") as String).trim()
if (!(mail ==~ /^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/)) {
    throw new java.lang.IllegalStateException("The work e-mail is not a valid address: " + mail)
}

// Vybraný vedúci: práve jeden, nie žiadateľ, a s rolou vedúceho.
def approvers = userIdsOf(on_approver.value)
if (approvers.size() != 1) {
    throw new java.lang.IllegalStateException(
            "Pick exactly one manager who is to approve this onboarding.")
}
def requesters = userIdsOf(on_requester.value)
if (approvers[0] in requesters || approvers[0] == (loggedUser().id as String)) {
    // Štvoro očí začína smerovaním, nie odmietnutím: kto žiadosť podal, tú
    // úlohu ani neuvidí. Guard na rozhodnutí zostáva ako druhá línia.
    throw new java.lang.IllegalStateException(
            "The requester cannot approve their own request - pick somebody else.")
}
if (!usersWithRole(on_approver.value, "approver", "onboarding/on_request")) {
    // Bez tejto kontroly by žiadosť pokojne čakala na človeka, ktorý ju
    // schváliť smie (userRef mu to dá), ale nikto ho za vedúceho nepovažuje -
    // a nikde by sa to nepovedalo.
    throw new java.lang.IllegalStateException(
            "The chosen person does not have the Manager role and cannot approve onboardings.")
}
				]]></action>
			</actions>
			<actions phase="post">
				<action id="3"><![CDATA[
on_first_name: f.on_first_name, on_last_name: f.on_last_name, on_position: f.on_position,
on_status: f.on_status, on_submitted_at: f.on_submitted_at,
on_approver: f.on_approver, on_approver_name: f.on_approver_name,
on_history: f.on_history;

def again = (((on_status.value ?: "") as String) == "returned")
def approver = menaUzivatelov(on_approver.value).join(", ")

change on_status value { "awaiting_approval" }
change on_approver_name value { approver }
change on_submitted_at value { java.time.LocalDateTime.now() }
changeCaseProperty("title").about { case_name(on_first_name, on_last_name, on_position) }
changeCaseProperty("color").about { colour("awaiting_approval") }
log_entry(on_history, (again ? "resubmitted for approval to " : "submitted for approval to ") + approver)
				]]></action>
			</actions>
		</event>
