	<!--
		Nástup nového zamestnanca: jedna žiadosť, jedno schválenie a jedno
		miesto, kde vidno, kde to viazne.

		  p_draft -> t_on_request -> p_awaiting_approval -> t_on_approval -+-> p_accounts -> t_on_accounts -> p_done
		     ^                                                            |                                       |
		     +.......... variable arc, keď vedúci vráti na doplnenie ......+                  read arc -> t_on_overview

		Suradnice uzlov su zvolene tak, aby model v builderi nebol v jednej
		ciare, ale aby z neho bolo rozhodnutie vidno: podanie ide po y=280,
		SCHVALENE stupa doprava hore (y=140), VRATENE sa vracia dolu spat do
		`p_draft` (lomove body na y=460) a read-only pohlad visi pod koncovym
		miestom. Su to len suradnice platna - na behanie procesu nemaju vplyv.

		Štyri pravidlá zo zadania a to, čo ich drží - žiadne z nich nie je
		vo frontende, všetky sú v modeli:

		  * „Schvaľuje len ten jeden vybraný vedúci."  `on_approver` je
		    userList, ktorý vyplní personalista pri podaní, a na prechode
		    `t_on_approval` visí `userRef` naň. Rola `approver` na tom prechode
		    ZÁMERNE NIE JE: `roleRef` a `userRef` sa zjednocujú (nie pretínajú),
		    takže by žiadosť schválil ktokoľvek s tou rolou a výber vedúceho by
		    nebol na nič (RUNBOOK 11, PETRIFLOW_LEARNINGS B14).
		  * „Pred schválením sa nezakladá nič."  `t_on_accounts` je za miestom
		    `p_accounts`, do ktorého sa token dostane jedine cez schválenie. Nie
		    je to kontrola v akcii, ktorú by sa dalo obísť - je to štruktúra
		    siete.
		  * „Žiadateľ nesmie schvaľovať vlastnú žiadosť."  Kontroluje sa pri
		    podaní (tam sa vedúci vyberá) aj pri rozhodovaní (druhá línia - pole
		    sa dá prepísať cez API).
		  * „Vrátená žiadosť sa nezahadzuje, pokračuje tá istá."  Vrátenie je
		    variable arc späť do `p_draft`, teda ten istý case s tými istými
		    dátami; `on_history` drží, čo sa medzitým dialo.

		Kto čo vidí:

		  personalista (`hr`)   všetky žiadosti (`view` na procese) - je to jeho
		                        agenda a jeho zoznam „moje žiadosti a v akom sú stave"
		  vedúci (`approver`)   len tie, kde je vybraný ako schvaľovateľ (`userRef`),
		                        preto rola `approver` `view` na procese NEMÁ
		  IT správca            všetky - bez toho nemá ako zakladať účty
		  žiadateľ              svoju vlastnú (`userRef` na `on_requester`)

		Read-only pohľad `t_on_overview` visí na read arcu z `p_done`, čo je
		SINK - nikto ho nekonzumuje, takže odmietnuté DOKONČIŤ na inom prechode
		ho nemôže zmazať (PETRIFLOW_LEARNINGS B8b).

		Skutočná integrácia na Entra ID a Atlassian v zadaní nie je: IT správca
		účty odškrtáva ručne. Až príde, vymení sa obsah `t_on_accounts` (kto
		odškrtáva) - miesta, prechody ani oprávnenia sa meniť nemusia.
	-->
	<caseEvents>
		<event type="create">
			<id>on_create</id>
			<actions phase="post">
				<action id="1"><![CDATA[
on_requester: f.on_requester, on_requester_name: f.on_requester_name,
on_status: f.on_status, on_first_name: f.on_first_name, on_last_name: f.on_last_name,
on_position: f.on_position, on_history: f.on_history;

def u = loggedUser()

// Na tomto zozname visí právo žiadosť vidieť aj právo ju dopísať.
change on_requester value { [u.id] }
change on_requester_name value { who(u) }
// KLUC moznosti, nie popisok - popisok si engine prelozi sam.
change on_status value { "draft" }
changeCaseProperty("title").about { case_name(on_first_name, on_last_name, on_position) }
changeCaseProperty("color").about { colour("draft") }
log_entry(on_history, "request created (" + who(u) + ")")
				]]></action>
			</actions>
		</event>
	</caseEvents>
	<function scope="process" name="who"><![CDATA[
{ def u ->
    // `?.` chráni pred null, nie pred chýbajúcou property - na chýbajúcej
    // vyhodí MissingPropertyException uprostred akcie, teda časť zmien
    // zapísaná a zvyšok nie.
    return (u.hasProperty("fullName") && u.fullName) ? (u.fullName as String) : (u.email as String)
}
	]]></function>
	<function scope="process" name="case_name"><![CDATA[
{ def on_first_name, def on_last_name, def on_position ->
    // BEZ STAVU: `Case.title` je v engine obyčajný `String`, takže sa
    // neprekladá - stav v názve by v druhom jazyku bol jediné nepreložené
    // slovo v každom zozname. Stav nesie pole `on_status` a stĺpec, a ten
    // preložený je (RUNBOOK 9).
    def meno = (((on_first_name.value ?: "") as String).trim() + " " +
            ((on_last_name.value ?: "") as String).trim()).trim()
    def poz = ((on_position.value ?: "") as String).trim()
    // Kým meno nie je vyplnené, názov nesie číslo prípadu - to je lepšie
    // než prázdny riadok v zozname.
    if (!meno) return ((useCase.visualId ?: "?") as String)
    return poz ? (meno + " · " + poz) : meno
}
	]]></function>
	<function scope="process" name="colour"><![CDATA[
{ def statusKey ->
    // Farba prípadu je jediné, čo je v zozname vidno bez čítania - obarví sa
    // ňou ikona riadku. Paleta enginu: red|orange|yellow|green|teal|cyan|
    // blue|indigo|purple|pink|brown|grey.
    def m = ["draft"             : "grey",     // nič sa ešte nedeje
             "awaiting_approval" : "blue",     // je to v obehu
             "returned"          : "orange",   // personalista má niečo spraviť
             "accounts"          : "indigo",   // IT zakladá účty
             "done"              : "green"]
    return m[statusKey as String] ?: "grey"
}
	]]></function>
	<function scope="process" name="log_entry"><![CDATA[
{ def on_history, def text ->
    // Bez tohto by sa pri druhom kole poznámka vedúceho prepísala a nebolo by
    // vidieť, čo si personalista a vedúci medzi sebou vymenili.
    def ts = java.time.LocalDateTime.now()
            .format(java.time.format.DateTimeFormatter.ofPattern("d.M.yyyy HH:mm"))
    def log = (on_history.value ?: "") as String
    def riadok = ts + "  " + (text as String)
    change on_history value { log ? log + "\n" + riadok : riadok }
}
	]]></function>
	<function scope="process" name="accounts_status"><![CDATA[
{ def on_entra, def on_atlassian, def on_portal ->
    def hotove = []
    def chybaju = []
    [["Entra ID", on_entra], ["Atlassian", on_atlassian], ["Netgrif portal", on_portal]].each { par ->
        if (par[1].value as Boolean) { hotove << par[0] } else { chybaju << par[0] }
    }
    return [done: hotove, missing: chybaju]
}
	]]></function>
	<!--
		Oprávnenia case-u. `hr` má `view` na všetko: nástupy sú jeho agenda
		a zoznam „moje žiadosti a v akom sú stave" je zoznam case-ov, ktorý sa
		filtruje oprávnením `view`, nie tým, kto na nich má úlohu.

		`approver` tu `view` NEMÁ. Vedúci má vidieť tie žiadosti, kde bol
		vybraný - a to zariadi `userRef` na `on_approver`, nie rola.
	-->
	<roleRef>
		<id>hr</id>
		<caseLogic>
			<create>true</create>
			<view>true</view>
		</caseLogic>
	</roleRef>
	<roleRef>
		<id>it_admin</id>
		<caseLogic>
			<view>true</view>
		</caseLogic>
	</roleRef>
	<userRef>
		<id>on_requester</id>
		<caseLogic>
			<view>true</view>
		</caseLogic>
	</userRef>
	<userRef>
		<id>on_approver</id>
		<caseLogic>
			<view>true</view>
		</caseLogic>
	</userRef>
	<role>
		<id>hr</id>
		<title name="hr_title">HR officer</title>
	</role>
