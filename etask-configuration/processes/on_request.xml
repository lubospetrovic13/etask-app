		<event type="finish">
			<id>t_on_approval_finish</id>
			<title name="t_on_approval_finish_t">Submit the decision</title>
			<actions phase="pre">
				<action id="4"><![CDATA[
on_decision: f.on_decision, on_note: f.on_note,
on_requester: f.on_requester, on_to_accounts: f.on_to_accounts, on_to_draft: f.on_to_draft;

// SMEROVANIE MUSÍ BYŤ V phase="pre". Engine vyhodnotí násobnosti variable
// arcov po `pre` a pred `post`; keby sa príznaky nastavili v `post`, token by
// sa pohol s pôvodnými nulami a nevystrelil by ani jeden arc - prípad by
// zostal bez tokenu (petriflow_reference C4).
def choice = ((on_decision.value ?: "") as String).trim()

if (!choice) {
    throw new java.lang.IllegalStateException(
            "Choose whether you approve the onboarding or send it back for completion.")
}
if (!(choice in ["approved", "returned"])) {
    // Bez tohto by neznáma hodnota nechala oba príznaky na nule a token by sa
    // z p_awaiting_approval stratil bez toho, aby kdekoľvek pribudol.
    throw new java.lang.IllegalStateException("Unknown decision: " + choice)
}
if (choice == "returned" && !(((on_note.value ?: "") as String).trim())) {
    // Povinné je to len pri vrátení, takže sa to nedá vyjadriť `required`
    // na dataRefe - ten platí pre obe možnosti naraz.
    throw new java.lang.IllegalStateException("Write what HR has to add.")
}
// Druhá línia štvorech očí: `on_approver` sa dá prepísať akciou aj cez API.
if ((loggedUser().id as String) in userIdsOf(on_requester.value)) {
    throw new java.lang.IllegalStateException(
            "The requester cannot approve their own request.")
}

change on_to_accounts value { (choice == "approved" ? 1 : 0) as Double }
change on_to_draft    value { (choice == "approved" ? 0 : 1) as Double }
				]]></action>
			</actions>
			<actions phase="post">
				<action id="5"><![CDATA[
on_decision: f.on_decision, on_status: f.on_status,
on_approved_by: f.on_approved_by, on_approved_at: f.on_approved_at,
on_note: f.on_note, on_history: f.on_history;

def choice = ((on_decision.value ?: "") as String).trim()
def me = who(loggedUser())
def note = ((on_note.value ?: "") as String).trim()

if (choice == "approved") {
    change on_status value { "accounts" }
    change on_approved_by value { me }
    change on_approved_at value { java.time.LocalDateTime.now() }
    changeCaseProperty("color").about { colour("accounts") }
    log_entry(on_history, "approved (" + me + ")" + (note ? ": " + note : "") +
            " - accounts can be created")
} else {
    // Vrátenie nie je rozhodnutie - žiadosť sa vracia do hry, takže „Schválil"
    // zostáva prázdne.
    change on_status value { "returned" }
    changeCaseProperty("color").about { colour("returned") }
    log_entry(on_history, "sent back for completion (" + me + "): " + note)
}

// Vynulovať výber, inak by pri ďalšom kole bola v selecte predvyplnená minulá
// voľba a DOKONČIŤ by prešlo bez toho, aby sa vedúci na čokoľvek pozrel.
change on_decision value { null }
				]]></action>
