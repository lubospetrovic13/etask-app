	<transition>
		<id>t_on_request</id>
		<x>300</x>
		<y>280</y>
		<label name="t_on_request_label">Onboarding request</label>
		<icon>edit_note</icon>
		<!--
			`auto` je v poriadku na OSOBNU ulohu jedneho aktera. Na zdielanu
			(pult, front, prepazka) patri `manual` - auto ju priradi tomu, kto
			ju vyrobil (PETRIFLOW_LEARNINGS B21).
		-->
		<assignPolicy>auto</assignPolicy>
		<!--
			Iba žiadateľ. Rola `hr` tu zámerne nie je: roleRef a userRef sa
			zjednocujú, takže by rozpísanú žiadosť dokončil ktokoľvek z HR.
		-->
		<userRef>
			<id>on_requester</id>
			<logic>
				<perform>true</perform>
			</logic>
		</userRef>
		<dataGroup>
			<id>g_on_request</id>
