wi_finished_at: f.wi_finished_at, wi_result: f.wi_result, wi_message: f.wi_message,
wi_ticket_id: f.wi_ticket_id, wi_title: f.wi_title, wi_spent: f.wi_spent,
btn_start: f.btn_start, btn_done: f.btn_done, btn_cancel: f.btn_cancel;

// Posledny vstup pred tlacidlom je textarea, takze hodnotu citame az tu a
// nie v akcii tlacidla - inak by button videl prazdno (blur a klik v jednej
// poziadavke, event tlacidla sa spracuje skor).
def result = ((wi_result.value ?: "") as String).trim()
if (result.length() < 3) {
    change wi_message value { "Napíšte prosím krátko, čo sa urobilo." }
} else {
    change wi_state value { "done" }
    change wi_state_label value { state_label("done") }
