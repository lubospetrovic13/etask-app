				</logic>
				<layout>
					<x>0</x>
					<y>3</y>
					<rows>2</rows>
					<cols>6</cols>
					<template>material</template>
					<appearance>outline</appearance>
				</layout>
			</dataRef>
		</dataGroup>
	</transition>
	<place>
		<id>p_alive</id>
		<x>32</x>
		<y>80</y>
		<label>Živý</label>
		<tokens>1</tokens>
		<static>false</static>
	</place>
	<arc>
		<id>a_customer</id>
		<type>read</type>
		<sourceId>p_alive</sourceId>
		<destinationId>t_customer</destinationId>
		<multiplicity>1</multiplicity>
	</arc>
	<arc>
		<id>a_customer_read</id>
		<type>read</type>
		<sourceId>p_alive</sourceId>
		<destinationId>t_customer_read</destinationId>
		<multiplicity>1</multiplicity>
	</arc>
</document>
