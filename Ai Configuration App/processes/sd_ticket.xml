	<function scope="process" name="sla_hours"><![CDATA[
{ def priority ->
    // Lehota odozvy v pracovnych hodinach. Pre prvu fazu je matica tu;
    // v dalsej faze patri do samostatnej siete sla_policy, aby sa dala
    // menit bez nasadzovania novej verzie tejto siete.
    def m = ["A": 2, "B": 4, "C": 8]
    return (m[priority as String] ?: 8) as int
}
	]]></function>
	<function scope="process" name="business_deadline"><![CDATA[
{ def start, def hours ->
    // Pracovny cas Po-Pi 08:00-16:00. Sviatky tato verzia neriesi - patria
    // do kalendara v backendovej sluzbe, nie do Groovy akcie.
    if (start == null) return null
    def cur = start
    int remaining = ((hours as int) * 60)
    int guard = 0
    while (remaining > 0 && guard < 1000) {
        guard++
        if (cur.dayOfWeek.value >= 6) {
            cur = cur.plusDays(1).withHour(8).withMinute(0).withSecond(0).withNano(0)
            continue
        }
        if (cur.hour < 8) {
            cur = cur.withHour(8).withMinute(0).withSecond(0).withNano(0)
            continue
        }
        if (cur.hour >= 16) {
            cur = cur.plusDays(1).withHour(8).withMinute(0).withSecond(0).withNano(0)
            continue
        }
        def endOfDay = cur.withHour(16).withMinute(0).withSecond(0).withNano(0)
        long avail = java.time.temporal.ChronoUnit.MINUTES.between(cur, endOfDay)
        if (avail >= remaining) return cur.plusMinutes(remaining)
        remaining -= (avail as int)
        cur = cur.plusDays(1).withHour(8).withMinute(0).withSecond(0).withNano(0)
    }
    return cur
}
	]]></function>
	<function scope="process" name="priority_color"><![CDATA[
{ def priority ->
    def m = ["A": "red", "B": "orange", "C": "green"]
    return m[priority as String] ?: "default"
}
	]]></function>
