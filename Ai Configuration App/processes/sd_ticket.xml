tk_priority: f.tk_priority, src_severity: f.src_severity,
tk_priority_changed: f.tk_priority_changed, tk_priority_reason: f.tk_priority_reason;

// Zmena priority oproti navrhu zakaznika je auditovana udalost a zmluvne
// zavazuje informovat nahlasovatela. Preto sa zapne pole na doduvodnenie
// a stane sa povinnym.
