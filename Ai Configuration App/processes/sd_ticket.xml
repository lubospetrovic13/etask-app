			<actions phase="post">
				<action id="4"><![CDATA[
tk_type: f.tk_type, tk_priority: f.tk_priority, tk_priority_reason: f.tk_priority_reason,
tk_priority_changed: f.tk_priority_changed, tk_state: f.tk_state,
src_title: f.src_title, src_email: f.src_email, src_name: f.src_name,
sla_created_at: f.sla_created_at, sla_accepted_at: f.sla_accepted_at,
sla_response_due: f.sla_response_due, sla_ok: f.sla_ok, sla_note: f.sla_note,
tk_worklog: f.tk_worklog;

def now = java.time.LocalDateTime.now()
def created = sla_created_at.value ?: now
def due = business_deadline(created, sla_hours(tk_priority.value))

change sla_accepted_at value { now }
change sla_response_due value { due }
change tk_state value { "accepted" }

boolean inTime = due == null || !now.isAfter(due)
change sla_ok value { inTime }
change sla_note value {
    inTime ? "Prevzaté v lehote odozvy." : "Lehota odozvy bola prekročená pri prevzatí."
}

changeCaseProperty("title").about {
    type_label(tk_type.value) + " — " + ((src_title.value ?: "bez názvu") as String)
}
changeCaseProperty("color").about { priority_color(tk_priority.value) }

def log = (tk_worklog.value ?: "") as String
def entry = now.toString() + "  triáž: zaradené ako " + type_label(tk_type.value) +
            ", priorita " + (tk_priority.value as String)
if (tk_priority_changed.value == true) {
    entry = entry + " (zmenená, dôvod: " + ((tk_priority_reason.value ?: "") as String) + ")"
}
change tk_worklog value { log ? log + "\n" + entry : entry }

// Informovanie nahlasovatela. Ak mail nie je nakonfigurovany, nesmie to
// zhodit triaz - ticket uz je prevzaty a to je dolezitejsie.
def mail = ((src_email.value ?: "") as String).trim()
if (mail) {
    try {
        def body = "Dobrý deň,\n\nvašu požiadavku sme prevzali.\n" +
                   "Zaradenie: " + type_label(tk_type.value) + "\n" +
                   "Priorita: " + (tk_priority.value as String) + "\n"
        if (tk_priority_changed.value == true) {
            body = body + "Prioritu sme upravili. Dôvod: " +
                   ((tk_priority_reason.value ?: "") as String) + "\n"
        }
        body = body + "\nOzveme sa vám s ďalším postupom."
        sendEmail([mail], "Požiadavka prevzatá", body)
    } catch (Exception e) {
        // Log v akcii nie je zarucene dostupny, takze zlyhanie zapiseme tam,
        // kde ho operator uvidi.
        change tk_worklog value {
            ((tk_worklog.value ?: "") as String) +
            "\nPOZOR: notifikáciu o prevzatí sa nepodarilo poslať (" + e.message + ")"
        }
    }
}
				]]></action>
			</actions>
