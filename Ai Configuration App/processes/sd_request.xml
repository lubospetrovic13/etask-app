	<function scope="process" name="net_prefix"><![CDATA[
{ def caseObj ->
    // Na single-tenant nasadeni premenna workspace neexistuje a processIdentifier
    // je bez prefixu. Odvodime ho z vlastneho casu - funguje na oboch nasadeniach
    // a je to jedina cesta, ktora funguje aj v anonymnom kontexte.
    def pid = caseObj.processIdentifier
    return pid.contains("/") ? pid.substring(0, pid.lastIndexOf("/") + 1) : ""
}
	]]></function>
	<function scope="process" name="severity_label"><![CDATA[
{ def code ->
    def m = ["A": "A - kritická", "B": "B - nekritická", "C": "C - nízka"]
    return m[code as String] ?: (code as String)
}
	]]></function>
