// Zalozime ticket v back-office sieti a prekopirujeme do neho podanie.
// Vsetky textove polia su tu uz davno ulozene - kazdy krok wizardu bol
// samostatna poziadavka, takze na tuto akciu sa gotcha o blur/kliku netyka.
// Najprv posklada payload z podania. Vsetky textove polia su tu uz davno
// ulozene - kazdy krok wizardu bol samostatna poziadavka.
def payload = [
    "src_type"        : ["value": req_type.value, "type": "enumeration_map"],
    "src_service"     : ["value": req_service.value, "type": "enumeration_map"],
    "src_title"       : ["value": req_title.value, "type": "text"],
    "src_description" : ["value": req_description.value, "type": "text"],
    "src_severity"    : ["value": req_severity.value, "type": "enumeration_map"],
    "src_steps"       : ["value": req_steps.value, "type": "text"],
    "src_workaround"  : ["value": req_workaround.value, "type": "text"],
    "src_name"        : ["value": req_name.value, "type": "text"],
    "src_email"       : ["value": req_email.value, "type": "text"],
    "src_phone"       : ["value": req_phone.value, "type": "text"],
    "src_org"         : ["value": req_org.value, "type": "text"],
    "src_affects_more": ["value": req_affects_more.value, "type": "boolean"],
    "src_request_id"  : ["value": useCase.stringId, "type": "text"],
    "tk_priority"     : ["value": req_severity.value, "type": "enumeration_map"],
    "tk_type"         : ["value": req_type.value, "type": "enumeration_map"]
]
if (req_started.value != null) {
    payload["src_started"] = ["value": req_started.value, "type": "dateTime"]
}

// Zalozenie ticketu sa moze nepodarit - napriklad na pravach. Zakaznikovi
// nesmieme tvrdit, ze je podane, ked v back-office nic nevzniklo.
try {
    def ticket = createCase(net_prefix(useCase) + "sd_ticket")
    change ticket_case_id value { ticket.stringId }
    change ticket_number value { ticket.visualId ?: ticket.stringId }
    change submitted_ok value { true }
    change receipt_note value {
        "Požiadavku sme prijali. Potvrdenie posielame na " +
        ((req_email.value ?: "") as String) +
        ". Operátor podpory ju prevezme a ozve sa vám."
    }
    async.run {
        setData("t_triage", ticket, payload)
    }
} catch (Exception e) {
    change submitted_ok value { false }
    change ticket_number value { "" }
    change receipt_note value {
        "Údaje sme uložili, ale požiadavku sa nepodarilo založiť do systému podpory. " +
        "Ozvite sa nám prosím telefonicky a uveďte tento kód: " + useCase.stringId +
        " (technický detail: " + e.message + ")"
    }
}
