	<function scope="process" name="state_label"><![CDATA[
{ def code ->
    def m = ["new": "New", "progress": "Prebieha", "done": "Done", "cancelled": "Cancelled"]
    return m[code as String] ?: (code as String)
}
	]]></function>
	<function scope="process" name="type_label"><![CDATA[
{ def code ->
    def m = ["analysis": "Analysis", "fix": "Oprava", "test": "Test",
             "deploy" : "Nasadenie", "other": "Other"]
    return m[code as String] ?: (code as String)
}
	]]></function>
	<function scope="process" name="report_to_ticket"><![CDATA[
{ def ticketId, def kind, def wiTitle, def spent, def result ->
    // Uzavretie kruhu: bez toho by tiket navzdy videl wi_open > 0 a t_resolve
    // by odmietal uzavriet poziadavku, aj keby bola vsetka praca hotova.
    def id = ((ticketId ?: "") as String).trim()
    if (!id) return false
    // Nie `findCase { it.stringId.eq(id) }` - Case nema pole stringId, mongo to
    // nezmapuje a query vrati null. Task caseId ale existuje, a setData aj tak
    // potrebuje task tiketu.
    def planTask = findTask { it.caseId.eq(id).and(it.transitionId.eq("t_plan")) }
    if (!planTask) return false
    def ticket = findCase { it._id.eq(new org.bson.types.ObjectId(id)) }
    if (!ticket) return false

    int open = ((ticket.dataSet["wi_open"]?.value ?: 0) as Number).intValue() - 1
    if (open < 0) open = 0

    def label = ((wiTitle ?: "") as String).trim()
    def line
    if (kind == "done") {
        def hours = ((spent ?: 0) as Number)
        line = "✓ " + label + "  (" + hours + " h)"
        def note = ((result ?: "") as String).trim()
        if (note) line = line + "\n    " + note
    } else {
        line = "✕ " + label + "  (cancelled)"
    }

    def prev = ((ticket.dataSet["wi_report"]?.value ?: "") as String)
    setData(planTask, [
            "wi_open"  : ["value": open, "type": "number"],
            "wi_report": ["value": (prev ? prev + "\n" + line : line), "type": "text"]
    ])
    return true
}
	]]></function>
