		</component>
		<init>1</init>
		<event type="set">
			<id>btn_start_set</id>
			<actions phase="post">
				<action id="2"><![CDATA[
wi_state: f.wi_state, wi_state_label: f.wi_state_label, wi_started_at: f.wi_started_at,
btn_start: f.btn_start, btn_done: f.btn_done;

change wi_state value { "progress" }
change wi_state_label value { state_label("progress") }
change wi_started_at value { new Date() }
