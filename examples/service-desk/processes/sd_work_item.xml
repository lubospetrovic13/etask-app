	</data>
	<data type="button">
		<id>btn_done</id>
		<title/>
		<placeholder name="btn_done_placeholder">Označiť ako hotové</placeholder>
		<component>
			<name>raised</name>
		</component>
		<init>1</init>
		<event type="set">
			<id>btn_done_set</id>
			<actions phase="post">
				<action id="3"><![CDATA[
wi_state: f.wi_state, wi_state_label: f.wi_state_label, wi_done: f.wi_done,
wi_finished_at: f.wi_finished_at, wi_result: f.wi_result, wi_message: f.wi_message,
wi_ticket_id: f.wi_ticket_id, wi_title: f.wi_title, wi_spent: f.wi_spent,
btn_start: f.btn_start, btn_done: f.btn_done, btn_cancel: f.btn_cancel;

// Posledny vstup pred tlacidlom je textarea, takze hodnotu citame az tu a
// nie v akcii tlacidla - inak by button videl prazdno (blur a klik v jednej
// poziadavke, event tlacidla sa spracuje skor).
def result = ((wi_result.value ?: "") as String).trim()
if (result.length() < 3) {
    change wi_message value { "Please write briefly what was done." }
} else {
    change wi_state value { "done" }
    change wi_state_label value { state_label("done") }
    change wi_done value { true }
    change wi_finished_at value { new Date() }
    change wi_message value { "" }
    make btn_done, hidden on transitions when { return true }
    make btn_cancel, hidden on transitions when { return true }
    report_to_ticket(wi_ticket_id.value, "done", wi_title.value, wi_spent.value, result)
}
				]]></action>
			</actions>
		</event>
