# Skopíruj na server ako deploy/.env a vyplň. Tento súbor NEOBSAHUJE tajomstvá
# a je v gite; .env na serveri je mimo git a nikdy sa tam nedostane.
#
#   cp .env.example .env && ${EDITOR:-vi} .env
#   chmod 600 .env

# --- povinné ---------------------------------------------------------------

# Verejná adresa, na ktorej appku vidí zákazník. Backend ju používa
# v odkazoch v e-mailoch.
PUBLIC_URL=https://sd.example.com

# Obrazy. Pipeline ich pri každom deployi prepíše na konkrétny commit,
# takže tu stačí ponechať latest ako fallback pre ručný štart.
BACKEND_IMAGE=ghcr.io/lubospetrovic13/etask-backend:latest
FRONTEND_IMAGE=ghcr.io/lubospetrovic13/etask-frontend:latest

# --- voliteľné -------------------------------------------------------------

DATABASE_NAME=etask

# Port, na ktorom frontend kontajner poslúcha na hostiteľovi. Napoj naň
# svoju existujúcu reverznú proxy. Pri profile "edge" ho netreba meniť.
FRONTEND_PORT=8081

# Len pre profil "edge" - Caddy si na túto domému vyžiada certifikát.
DOMAIN=sd.example.com

FRONTEND_LOG_LEVEL=error

# Heap backendu. Pri 8 GB serveri je 2g rozumné (mongo 2G + elastic 2G).
BACKEND_JAVA_OPTS=-Xms512m -Xmx2g

# Odosielateľ notifikácií
MAIL_FROM=servicedesk@example.com

# Bez tohto kľúča backend nabehne, len AI volanie vyhodí hlášku. To je zámer.
ANTHROPIC_API_KEY=

# Heslo testovacích účtov, ktoré vytvorí EtaskUserCreator pri prvom starte.
# V produkcii nastav alebo tie účty po nasadení zmaž.
ETASK_TEST_PASSWORD=

# --- smoke test po deployi -------------------------------------------------
#
# Pipeline po nasadení overí, že prihlásenie naozaj vráti token. Nie len že
# port odpovedá - appka môže bežať a login pritom padať na 500, ak zlyhal
# import procesu a nechal po sebe osirelé procesné role.
# Keď necháš prázdne, tento krok sa preskočí a nahlási to.
SMOKE_USER=
SMOKE_PASSWORD=
